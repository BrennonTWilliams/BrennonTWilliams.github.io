---
/**
 * §-numeral section header. The numeral and eyebrow are decorative (aria-hidden);
 * only the `title` is announced. Title may contain raw <em> for coral italic.
 */
interface Props {
  numeral: string
  title: string
  eyebrow?: string
  coord?: string
  id?: string
  level?: 1 | 2
}
const { numeral, title, eyebrow, coord, id, level = 2 } = Astro.props
const Heading = `h${level}` as 'h1' | 'h2'
---

<header class="ed-section-header" id={id}>
  <span class="numeral roman" aria-hidden="true">§ {numeral}</span>
  <Heading data-reveal set:html={title} />
  {(eyebrow || coord) && (
    <div class="meta-grp" aria-hidden="true">
      {eyebrow && <span class="eyebrow">{eyebrow}</span>}
      {coord && <span class="coord">{coord}</span>}
    </div>
  )}
</header>

<style>
  .ed-section-header {
    display: grid;
    grid-template-columns: auto 1fr auto;
    gap: 24px;
    align-items: end;
    margin-bottom: 40px;
    padding-bottom: 20px;
    border-bottom: 1px solid var(--line);
  }
  .ed-section-header :global(h1),
  .ed-section-header :global(h2) {
    font-family: var(--serif);
    font-weight: 500;
    font-size: clamp(34px, 4.2vw, 56px);
    line-height: 1.02;
    letter-spacing: -0.015em;
    color: var(--ink);
    text-wrap: balance;
    margin: 0;
  }
  .ed-section-header :global(h1 em),
  .ed-section-header :global(h2 em) {
    color: var(--coral);
    font-style: italic;
  }
  .numeral {
    font-family: var(--serif);
    font-style: italic;
    font-size: 22px;
    color: var(--ink-faint);
    align-self: end;
    padding-bottom: 0;
    transform: translateY(0.18em);
  }
  .meta-grp {
    display: flex;
    flex-direction: column;
    gap: 4px;
    align-items: flex-end;
  }
  .meta-grp .coord { color: var(--ink-mute); }
  .meta-grp .eyebrow { color: var(--coral); }

  @media (max-width: 820px) {
    .ed-section-header {
      grid-template-columns: 1fr;
      gap: 12px;
      margin-bottom: 36px;
    }
    .meta-grp { align-items: flex-start; }
  }
</style>
