---
import { Image } from 'astro:assets'
import { getCollection } from 'astro:content'
import EditorialLayout from '@/layouts/EditorialLayout.astro'
import EdSectionHeader from '@/components/EdSectionHeader.astro'
import EdWire from '@/components/EdWire.vue'
import WorkCard from '@/components/WorkCard.vue'
import WriteItem from '@/components/WriteItem.vue'
import siteConfig from '@/site-config'
import { sortProjects } from '@/utils/projects'
import { getPosts } from '@/utils/posts'
import headshotImage from '@/assets/images/profile/brennon-stylized-headshot-2025-cropped.png'

const allProjects = sortProjects((await getCollection('projects')).filter(p => !p.data.draft))
const selectedWork = allProjects.slice(0, 8)
const activeCount = allProjects.filter(p => p.data.status === 'active').length
const archiveCount = allProjects.length - selectedWork.length
const archiveSlugs = allProjects.slice(8).map(p => p.slug).join(', ')

const recentPosts = (await getPosts()).slice(0, 2)

const pad = (n: number) => String(n).padStart(2, '0')
const buildHash = (typeof __BUILD_HASH__ !== 'undefined' ? __BUILD_HASH__ : 'dev').slice(0, 7)
---

<EditorialLayout
  title={siteConfig.title}
  description={siteConfig.description}
  noMainWrapper={true}
>
  <!-- ─────── HERO ─────── -->
  <main id="main">
  <section class="home-hero">
    <div class="home-container hero-grid">
      <div class="hero-copy">
        <span class="label" data-reveal>{siteConfig.editorial.series.split('·')[0].trim()} <span class="ix">· {siteConfig.editorial.issue}</span></span>
        <h1 class="display" data-reveal>I wonder what the <em>machines</em> think<span class="dot">.</span></h1>
        <p class="lead" data-reveal>Brennon Williams — software architect working at the seam between <em>machine reasoning</em>, local-first systems, and physical computing. I build production agents, dev tooling, and the occasional circuit board, mostly from a small studio with one dog and a soldering iron.</p>

        <div class="hero-actions" data-reveal>
          <a class="btn btn-primary" href="#work">
            Selected work
            <span class="arrow"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 19L19 5M19 5H8M19 5v11"/></svg></span>
          </a>
          <a class="btn btn-ghost" href="#writing">
            Recent writing
            <span class="arrow"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M9 12h6M12 9v6"/></svg></span>
          </a>
        </div>

        <div class="hero-stats" data-reveal>
          <div class="stat">
            <span class="ring solid">{allProjects.length}</span>
            <span class="stat-label"><b>projects</b>active &amp; archive</span>
          </div>
          <div class="stat">
            <span class="ring">15+</span>
            <span class="stat-label"><b>years</b>shipping software</span>
          </div>
          <div class="stat">
            <span class="ring coral">1</span>
            <span class="stat-label"><b>good dog</b>under the desk</span>
          </div>
        </div>

        <div class="hero-foot" data-reveal>
          <span class="meta">↳&nbsp;&nbsp;{siteConfig.editorial.location}</span>
          <span class="coord">{siteConfig.editorial.coords}</span>
        </div>
      </div>

      <div class="hero-art" data-reveal>
        <span class="corner tl"></span>
        <span class="corner tr"></span>
        <span class="corner bl"></span>
        <span class="corner br"></span>
        <span class="annot annot-tl coord">FIG. 01 / BW-26</span>
        <span class="annot annot-tr">Plate {siteConfig.editorial.issue}</span>
        <span class="annot annot-bl coord">SHA · {buildHash}</span>
        <span class="annot annot-br">Composed in&nbsp;<span style="color:var(--coral)">graphite</span></span>
        <Image
          src={headshotImage}
          alt="Brennon Williams, portrait"
          width={720}
          height={900}
          format="webp"
          quality={88}
          loading="eager"
          class="hero-portrait"
        />
        <div class="art-index" aria-hidden="true">
          <span><span class="n">01</span>Read</span>
          <span><span class="n">02</span>Build</span>
          <span class="on"><span class="n">03</span>Ship</span>
          <span><span class="n">04</span>Repeat</span>
        </div>
      </div>
    </div>
  </section>
  </main>

  <!-- ─────── WIRE ─────── -->
  <EdWire activeCount={activeCount} client:visible />

  <!-- ─────── ABOUT §I ─────── -->
  <section class="home-section" id="about">
    <div class="home-container">
      <EdSectionHeader
        numeral="I"
        title="An <em>essay</em> in three paragraphs."
        eyebrow="About — Nº 01"
        coord="Filed 2026 · prose"
      />

      <div class="about-grid">
        <div class="about-prose" data-reveal>
          <p>I'm a software architect, mostly working at the seam between <em>machine reasoning</em> and the messier world of production systems. I write Python, TypeScript, and a fair amount of C# &amp; Lua — but the language I'm most fluent in is probably <a href="#work">specfile-to-shipped-thing</a>.</p>
          <p>My favorite problems are the ones where an LLM has to <em>actually decide</em> something — orchestrate tools, draw the next bone in a rig, pick up the conversation thread mid-sentence. Lately that means agent loops in Blender, a self-hosted voice assistant that runs offline, and a Claude Code plugin I keep accidentally turning into a project manager.</p>
          <p>Before that: game AI, Unity, custom PCBs, a smartphone-to-hardware bridge built out of a 3.5mm jack. I read a lot, hike, and live with one extremely good dog.</p>
        </div>

        <aside class="dispatch" data-reveal>
          <div class="dispatch-row">
            <span class="k">Role</span>
            <span class="v"><b>Software Architect</b><span class="tag">— AI/ML</span></span>
          </div>
          <div class="dispatch-row">
            <span class="k">Currents</span>
            <span class="v">{siteConfig.editorial.sideRails.left}</span>
          </div>
          <div class="dispatch-row">
            <span class="k">Stack</span>
            <span class="v">Python · TypeScript · BAML · Claude CLI · Ollama · Unity</span>
          </div>
          <div class="dispatch-row">
            <span class="k">Off-screen</span>
            <span class="v">Hiker · reader · tinkerer · dog dad</span>
          </div>
          <div class="dispatch-row">
            <span class="k">Status</span>
            <span class="v status-row"><span class="status-dot" aria-hidden="true"></span>Open to select collaboration</span>
          </div>
        </aside>
      </div>
    </div>
  </section>

  <!-- ─────── SELECTED WORK §II ─────── -->
  <section class="home-section" id="work">
    <div class="home-container">
      <EdSectionHeader
        numeral="II"
        title="Selected <em>work</em>, mostly things that decide for themselves."
        eyebrow="Work — Nº 02"
        coord={`${allProjects.length} entries · 2012 – 2026`}
      />

      <div class="work-grid">
        {selectedWork.map((project, i) => (
          <WorkCard
            client:visible
            idx={pad(i + 1)}
            category={project.data.category}
            name={project.data.title}
            stack={project.data.stack}
            blurb={project.data.summary}
            status={project.data.status}
            href={project.data.link?.href ?? project.data.website ?? project.data.repo ?? `/projects/${project.slug}/`}
            external={Boolean(project.data.link?.href ?? project.data.website ?? project.data.repo)}
          />
        ))}
      </div>

      <div class="work-foot">
        {archiveCount > 0 && (
          <span>↳ {archiveCount} more in the archive{archiveSlugs ? ` — ${archiveSlugs}` : ''}</span>
        )}
        <a href="/projects/" class="see-all">All projects →</a>
      </div>
    </div>
  </section>

  <!-- ─────── WRITING §III ─────── -->
  <section class="home-section" id="writing">
    <div class="home-container">
      <EdSectionHeader
        numeral="III"
        title="Long-form, mostly about how <em>models think</em>."
        eyebrow="Writing — Nº 03"
        coord={`${pad(recentPosts.length)} essays · indexed`}
      />

      {recentPosts.length > 0 ? (
        <div class="writing-grid">
          {recentPosts.map(post => {
            const month = post.data.dateRaw.toLocaleString('en', { month: 'short', timeZone: 'UTC' }).toUpperCase()
            return (
              <WriteItem
                client:visible
                year={post.data.dateRaw.getUTCFullYear()}
                month={month}
                name={post.data.title}
                desc={post.data.description}
                tags={post.data.tag ? [post.data.tag] : []}
                href={`/posts/${post.slug}/`}
              />
            )
          })}
        </div>
      ) : (
        <p class="empty">No essays indexed yet. Notebook is open.</p>
      )}

      <div class="work-foot">
        <a href="/blog/" class="see-all">All writing →</a>
      </div>
    </div>
  </section>

  <!-- ─────── NOW §IV ─────── -->
  <section class="home-section now-section" id="now">
    <div class="home-container">
      <EdSectionHeader
        numeral="IV"
        title="What I'm <em>doing</em> right now."
        eyebrow="Now — Nº 04"
        coord={`Updated ${siteConfig.now.lastUpdated}`}
      />

      <div class="now-strip">
        {siteConfig.now.entries.map(entry => (
          <div class="now-col" data-reveal>
            <div class="k">{entry.kind}</div>
            <div class="v" set:html={entry.title} />
            <div class="sub">{entry.meta}</div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ─────── CONTACT §V ─────── -->
  <section class="home-cta" id="contact">
    <div class="home-container cta-grid">
      <div>
        <span class="label" data-reveal>Get in touch <span class="ix">· Nº 05</span></span>
        <h2 class="cta-headline" data-reveal>If you're building something where a model has to <em>actually decide</em> — let's talk.</h2>
      </div>
      <div class="cta-actions" data-reveal>
        <a class="email-pill" href={`mailto:${siteConfig.email}`}>
          <span>{siteConfig.email}</span>
          <span class="arrow-circle"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 19L19 5M19 5H8M19 5v11"/></svg></span>
        </a>
        <span class="cta-foot">Reply window · usually within 48 hrs · select collaborations only</span>
      </div>
    </div>
  </section>
</EditorialLayout>

<style is:global>
  /* Homepage-specific layout. Components keep their own scoped styles;
     this stylesheet covers the editorial sections and bare HTML scaffolding. */

  .home-container {
    max-width: 1360px;
    margin: 0 auto;
    padding: 0 64px;
    position: relative;
  }
  @media (max-width: 820px) {
    .home-container { padding: 0 22px; }
  }

  /* ---------- HERO ---------- */
  .home-hero { padding: 80px 0 56px; position: relative; }
  .hero-grid {
    display: grid;
    grid-template-columns: 1.15fr 0.85fr;
    gap: 64px;
    align-items: start;
  }
  .hero-copy { padding-top: 4px; }

  .label {
    font-family: var(--sans);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: var(--ink-mute);
    display: inline-flex;
    align-items: baseline;
    gap: 10px;
  }
  .label .ix {
    color: var(--ink-faint);
    font-family: var(--mono);
    letter-spacing: 0.12em;
    font-size: 10.5px;
  }

  .display {
    font-family: var(--serif);
    font-weight: 500;
    font-size: var(--fs-display);
    line-height: 0.96;
    letter-spacing: -0.02em;
    margin: 22px 0 28px;
    color: var(--ink);
    text-wrap: balance;
  }
  .display em { font-style: italic; font-weight: 500; color: var(--coral); }
  .display .dot { color: var(--coral); }

  .lead {
    font-family: var(--body);
    font-size: 19px;
    line-height: 1.55;
    color: var(--ink-soft);
    max-width: 560px;
    margin-bottom: 32px;
    text-wrap: pretty;
  }
  .lead em { font-style: italic; color: var(--coral); }

  .hero-actions {
    display: inline-flex;
    flex-wrap: wrap;
    gap: 14px;
    margin-bottom: 48px;
  }
  .btn .arrow { width: 16px; height: 16px; display: inline-grid; place-items: center; }
  .btn .arrow svg { width: 16px; height: 16px; stroke: currentColor; fill: none; stroke-width: 1.6; }

  .hero-stats {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 24px;
    padding: 28px 0;
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
  }
  .stat { display: flex; align-items: center; gap: 14px; }
  .stat .ring {
    width: 56px; height: 56px;
    border-radius: 50%;
    display: inline-grid;
    place-items: center;
    border: 1px solid var(--ink);
    background: transparent;
    font-family: var(--serif);
    font-size: 22px;
    font-weight: 600;
    color: var(--ink);
    flex-shrink: 0;
  }
  .stat .ring.solid { background: var(--ink); color: var(--paper); }
  .stat .ring.coral {
    background: var(--coral);
    border-color: var(--coral);
    color: var(--bone);
  }
  .stat-label {
    display: flex;
    flex-direction: column;
    gap: 2px;
    font-family: var(--sans);
    font-size: 12px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink-faint);
  }
  .stat-label b { color: var(--ink); font-weight: 600; }

  .hero-foot {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 24px;
    margin-top: 22px;
  }
  .hero-foot .meta {
    font-family: var(--mono);
    font-size: 11.5px;
    color: var(--ink-mute);
    letter-spacing: 0.02em;
  }

  /* hero art / portrait plate */
  .hero-art {
    position: relative;
    aspect-ratio: 4 / 5;
    background: var(--bone);
    border: 1px solid var(--ink);
    overflow: hidden;
    isolation: isolate;
  }
  .hero-portrait {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: grayscale(1) contrast(1.05);
    mix-blend-mode: multiply;
  }
  html.dark .hero-portrait {
    filter: grayscale(1) contrast(0.95) brightness(0.92);
    mix-blend-mode: screen;
  }
  .hero-art::after {
    content: '';
    position: absolute; inset: 0;
    pointer-events: none;
    background: repeating-linear-gradient(180deg, transparent 0 3px, rgba(21,20,15,0.04) 3px 4px);
  }
  .corner {
    position: absolute;
    width: 18px; height: 18px;
    border: 1px solid var(--ink);
    z-index: 2;
    background: var(--bone);
  }
  .corner.tl { top: -1px; left: -1px; border-right: none; border-bottom: none; }
  .corner.tr { top: -1px; right: -1px; border-left: none; border-bottom: none; }
  .corner.bl { bottom: -1px; left: -1px; border-right: none; border-top: none; }
  .corner.br { bottom: -1px; right: -1px; border-left: none; border-top: none; }
  .annot {
    position: absolute;
    z-index: 2;
    padding: 4px 8px;
    background: var(--bone);
    border: 1px solid var(--ink);
    font-family: var(--sans);
    font-size: 9.5px;
    font-weight: 600;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--ink);
  }
  .annot-tl { top: 14px; left: 14px; }
  .annot-tr { top: 14px; right: 14px; }
  .annot-bl { bottom: 14px; left: 14px; }
  .annot-br { bottom: 14px; right: 14px; }

  .art-index {
    position: absolute;
    left: 14px; right: 14px; bottom: 48px;
    z-index: 2;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 6px;
    font-family: var(--mono);
    font-size: 10.5px;
    letter-spacing: 0.06em;
    color: var(--ink);
    text-transform: uppercase;
  }
  .art-index span {
    background: var(--bone);
    border: 1px solid var(--ink);
    padding: 6px 8px;
    display: flex;
    flex-direction: column;
    gap: 2px;
    opacity: 0.8;
  }
  .art-index .on {
    background: var(--coral);
    border-color: var(--coral);
    color: var(--bone);
    opacity: 1;
  }
  .art-index .n { font-size: 9px; color: var(--ink-faint); }
  .art-index .on .n { color: rgba(247, 241, 222, 0.7); }

  @media (max-width: 980px) {
    .home-hero { padding: 48px 0 40px; }
    .hero-grid { grid-template-columns: 1fr; gap: 40px; }
    .hero-stats { grid-template-columns: 1fr; gap: 16px; padding: 22px 0; }
  }

  /* ---------- SECTION shell ---------- */
  .home-section {
    padding: 96px 0;
    border-top: 1px solid var(--line);
    position: relative;
  }
  .home-section.now-section { padding-bottom: 56px; }
  @media (max-width: 820px) {
    .home-section { padding: 64px 0; }
  }

  /* ---------- ABOUT ---------- */
  .about-grid {
    display: grid;
    grid-template-columns: 1.05fr 0.95fr;
    gap: 64px;
    align-items: start;
  }
  .about-prose {
    font-family: var(--serif);
    font-size: 24px;
    line-height: 1.42;
    color: var(--ink);
    max-width: 580px;
    text-wrap: pretty;
  }
  .about-prose p + p { margin-top: 18px; }
  .about-prose em { color: var(--coral); font-style: italic; }
  .about-prose a {
    color: var(--ink);
    text-decoration: none;
    border-bottom: 1px solid var(--coral);
  }
  .about-prose a:hover { color: var(--coral); }

  .dispatch {
    border: 1px solid var(--ink);
    background: var(--bone);
    padding: 0;
  }
  .dispatch-row {
    display: grid;
    grid-template-columns: 132px 1fr;
    padding: 18px 22px;
    border-bottom: 1px solid var(--line);
    gap: 18px;
    align-items: baseline;
  }
  .dispatch-row:last-child { border-bottom: none; }
  .dispatch-row .k {
    font-family: var(--sans);
    font-size: 10.5px;
    font-weight: 600;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: var(--ink-faint);
  }
  .dispatch-row .v {
    font-family: var(--body);
    font-size: 15.5px;
    color: var(--ink);
    line-height: 1.4;
  }
  .dispatch-row .v b { font-weight: 600; }
  .dispatch-row .v .tag {
    font-family: var(--mono);
    font-size: 11.5px;
    color: var(--ink-mute);
    margin-left: 6px;
  }
  .dispatch-row .v.status-row {
    display: inline-flex;
    align-items: center;
    gap: 10px;
  }
  .status-dot {
    width: 7px; height: 7px;
    border-radius: 50%;
    background: var(--olive);
    display: inline-block;
    box-shadow: 0 0 0 3px rgba(110, 116, 72, 0.18);
  }

  @media (max-width: 980px) {
    .about-grid { grid-template-columns: 1fr; gap: 40px; }
    .dispatch-row { grid-template-columns: 100px 1fr; padding: 14px 18px; }
  }

  /* ---------- WORK + WRITING grid shells ---------- */
  .work-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0;
    border-top: 1px solid var(--ink);
  }
  .writing-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0;
    border-top: 1px solid var(--ink);
  }
  @media (max-width: 820px) {
    .writing-grid { grid-template-columns: 1fr; }
  }
  .work-foot {
    margin-top: 32px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
    flex-wrap: wrap;
    font-family: var(--mono);
    font-size: 11.5px;
    color: var(--ink-mute);
    letter-spacing: 0.04em;
  }
  .work-foot .see-all {
    color: var(--ink);
    text-decoration: none;
    border-bottom: 1px solid var(--coral);
    padding-bottom: 2px;
    text-transform: uppercase;
    letter-spacing: 0.18em;
    font-weight: 600;
    font-family: var(--sans);
    font-size: 11px;
  }
  .work-foot .see-all:hover { color: var(--coral); }
  .empty {
    font-family: var(--serif);
    font-style: italic;
    color: var(--ink-faint);
    padding: 24px 0;
  }

  /* ---------- NOW ---------- */
  .now-strip {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
  }
  .now-col {
    padding: 22px 24px;
    border-right: 1px solid var(--line);
  }
  .now-col:last-child { border-right: none; }
  .now-col .k {
    font-family: var(--sans);
    font-size: 10.5px;
    font-weight: 600;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: var(--ink-faint);
    margin-bottom: 14px;
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }
  .now-col .k::before {
    content: '';
    width: 6px; height: 6px;
    border-radius: 50%;
    background: var(--coral);
  }
  .now-col .v {
    font-family: var(--serif);
    font-size: 19px;
    font-weight: 500;
    line-height: 1.25;
    color: var(--ink);
    text-wrap: balance;
  }
  .now-col .v em { font-style: italic; color: var(--coral); }
  .now-col .sub {
    font-family: var(--mono);
    font-size: 11px;
    color: var(--ink-mute);
    margin-top: 8px;
    letter-spacing: 0.03em;
  }
  @media (max-width: 820px) {
    .now-strip { grid-template-columns: 1fr 1fr; }
    .now-col:nth-child(2n) { border-right: none; }
  }
  @media (max-width: 480px) {
    .now-strip { grid-template-columns: 1fr; }
    .now-col {
      border-right: none;
      border-bottom: 1px solid var(--line);
    }
    .now-col:last-child { border-bottom: none; }
  }

  /* ---------- CTA ---------- */
  .home-cta {
    padding: 120px 0 96px;
    border-top: 1px solid var(--line);
    position: relative;
  }
  .cta-grid {
    display: grid;
    grid-template-columns: 1.2fr 0.8fr;
    gap: 48px;
    align-items: end;
  }
  .cta-headline {
    font-family: var(--serif);
    font-weight: 500;
    font-size: clamp(34px, 4.2vw, 56px);
    line-height: 1.02;
    letter-spacing: -0.015em;
    color: var(--ink);
    text-wrap: balance;
    margin-top: 18px;
  }
  .cta-headline em { color: var(--coral); font-style: italic; }
  .cta-actions {
    display: flex;
    flex-direction: column;
    gap: 16px;
    align-items: flex-start;
