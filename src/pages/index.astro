---
import { Image } from 'astro:assets'
import { getCollection } from 'astro:content'
import EditorialLayout from '@/layouts/EditorialLayout.astro'
import EdSectionHeader from '@/components/EdSectionHeader.astro'
import PoVMarquee from '@/components/PoVMarquee.vue'
import ProjectCard from '@/components/ProjectCard.vue'
import WriteItem from '@/components/WriteItem.vue'
import siteConfig from '@/site-config'
import { sortProjects } from '@/utils/projects'
import { getPosts } from '@/utils/posts'
import headshotImage from '@/assets/images/profile/brennon-stylized-headshot-2025-cropped.png'

const allProjects = sortProjects((await getCollection('projects')).filter(p => !p.data.draft))
const flagship = allProjects.find(p => p.data.flagship) ?? allProjects[0]
const restProjects = allProjects.filter(p => p !== flagship)

const recentPosts = (await getPosts()).slice(0, 2)

const allBooks = (await getCollection('books')).flatMap(entry => entry.data)
const allWhitepapers = (await getCollection('whitepapers')).flatMap(entry => entry.data)
const readingHighlights = [
  ...allBooks
    .filter(book => book.featured)
    .map(book => ({ kind: 'Book', title: book.title, meta: book.author })),
  ...allWhitepapers
    .filter(paper => paper.featured)
    .map(paper => ({
      kind: 'Paper',
      title: paper.title,
      meta: [paper.author, String(paper.year)].filter(Boolean).join(' · '),
    })),
]

const pad = (n: number) => String(n).padStart(2, '0')
const buildHash = (typeof __BUILD_HASH__ !== 'undefined' ? __BUILD_HASH__ : 'dev').slice(0, 7)
---

<EditorialLayout
  title={siteConfig.title}
  description={siteConfig.description}
  noMainWrapper={true}
>
  <!-- ─────── HERO ─────── -->
  <main id="main">
  <section class="home-hero">
    <div class="home-container hero-grid">
      <div class="hero-copy">
        <span class="label" data-reveal>{siteConfig.editorial.series.split('·')[0].trim()} <span class="ix">· {siteConfig.editorial.issue}</span></span>
        <h1 class="display" data-reveal>I wonder what the <em>machines</em> think<span class="dot">.</span></h1>
        <p class="lead" data-reveal>Brennon Williams — software architect working at the seam between <em>machine reasoning</em>, local-first systems, and physical computing. I build production agents, dev tooling, and the occasional circuit board, mostly from a small studio with one dog and a soldering iron.</p>

        <div class="hero-actions" data-reveal>
          <a class="btn btn-primary" href="#work">
            Selected work
            <span class="arrow"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 19L19 5M19 5H8M19 5v11"/></svg></span>
          </a>
          <a class="btn btn-ghost" href="#writing">
            Recent writing
            <span class="arrow"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M9 12h6M12 9v6"/></svg></span>
          </a>
        </div>

        <div class="hero-stats" data-reveal>
          <div class="stat">
            <span class="ring solid">{allProjects.length}</span>
            <span class="stat-label"><b>projects</b>active &amp; archive</span>
          </div>
          <div class="stat">
            <span class="ring">15+</span>
            <span class="stat-label"><b>years</b>shipping software</span>
          </div>
          <div class="stat">
            <span class="ring coral">1</span>
            <span class="stat-label"><b>patent</b>material sensing probe</span>
          </div>
        </div>

        <div class="hero-foot" data-reveal>
          <span class="meta">↳&nbsp;&nbsp;{siteConfig.editorial.location}</span>
          <span class="coord">{siteConfig.editorial.coords}</span>
        </div>
      </div>

      <div class="hero-art" data-reveal>
        <span class="corner tl"></span>
        <span class="corner tr"></span>
        <span class="corner bl"></span>
        <span class="corner br"></span>
        <span class="annot annot-tl coord">FIG. 01 / BW-26</span>
        <span class="annot annot-tr">Plate {siteConfig.editorial.issue}</span>
        <span class="annot annot-bl coord">SHA · {buildHash}</span>
        <span class="annot annot-br">Composed in&nbsp;<span style="color:var(--coral)">graphite</span></span>
        <Image
          src={headshotImage}
          alt="Brennon Williams, portrait"
          width={720}
          height={900}
          format="webp"
          quality={88}
          loading="eager"
          class="hero-portrait"
        />
        <div class="art-index" aria-hidden="true">
          <span><span class="n">01</span>Read</span>
          <span><span class="n">02</span>Build</span>
          <span class="on"><span class="n">03</span>Ship</span>
          <span><span class="n">04</span>Repeat</span>
        </div>
      </div>
    </div>
  </section>
  </main>

  <!-- ─────── WIRE ─────── -->
  <PoVMarquee client:visible />

  <!-- ─────── ABOUT §I ─────── -->
  <section class="home-section" id="about">
    <div class="home-container">
      <EdSectionHeader
        numeral="I"
        title="The <em>project-based</em> life."
        eyebrow="About — Nº 01"
        coord="Filed 2026 · prose"
      />

      <div class="about-grid">
        <div class="about-prose" data-reveal>
          <p>I have always learned by building. At fourteen I was programming 3D scanners at a medical device startup to create prosthetic fittings. Soon I was at the IDEO toy lab, designing circuits for prototypes headed to Sesame Street and Mattel. A material sensing probe I designed was patented before I was old enough to vote. None of it felt like a career — I just kept finding the edge of what I understood and building past it.</p>
          <p>I studied Computer Science and English in college — I couldn't choose, and the two halves kept showing up in each other's work. My CS concentration was machine learning, and freshman year I built my first Hopfield network and fed it corrupted rings. Watching it reconstruct a perfect ring from a noisy, fragmentary input was my first contact with the <em>magic</em> of AI — the moment a system stopped feeling like code and started feeling like something mysterious and sublime. For years before ChatGPT I was building a utility-based AI framework in C# — software agents weighing competing dimensions of context to arrive at a decision.</p>
          <p>When ChatGPT released I made a decision I'd call intentional if it hadn't also felt inevitable — go all in on large language models as the center of my work and my life. The same obsession with artificial minds, now with far greater urgency and a clearer mission. I'm an AI architect now. I help enterprise teams ship production systems — agents that make business decisions, pipelines that run at scale, orchestration that coordinates context across domains. I also train engineers on using AI in software development. After hours I keep building: a Claude Code plugin that keeps becoming a project manager, an offline voice assistant, a system for agentic long-lived modeling in Blender. It's always been the same impulse: discover something I don't understand. Build something until I do.</p>
        </div>

        <aside class="dispatch" data-reveal>
          <div class="dispatch-row">
            <span class="k">Role</span>
            <span class="v"><b>AI Architect</b><span class="tag">— Training &amp; Delivery</span></span>
          </div>
          <div class="dispatch-row">
            <span class="k">Currents</span>
            <span class="v">SDLC automation · Agent loops · Enterprise AI · Physical computing</span>
          </div>
          <div class="dispatch-row">
            <span class="k">Stack</span>
            <span class="v">Python · TypeScript · BAML · llamacpp</span>
          </div>
          <div class="dispatch-row">
            <span class="k">Also</span>
            <span class="v">Patent-holder · Published Author · CS &amp; English</span>
          </div>
          <div class="dispatch-row">
            <span class="k">Off-screen</span>
            <span class="v">Hiker · reader · tinkerer · dog dad</span>
          </div>
          <div class="dispatch-row">
            <span class="k">Status</span>
            <span class="v status-row"><span class="status-dot" aria-hidden="true"></span>Open to select collaboration</span>
          </div>
        </aside>
      </div>
    </div>
  </section>

  <!-- ─────── WORK §II ─────── -->
  <section class="home-section" id="work">
    <div class="home-container">
      <EdSectionHeader
        numeral="II"
        title="Passion Projects"
        eyebrow="Work — Nº 02"
        coord={`${allProjects.length} entries · 2012 – 2026`}
      />

      <div class="flagship-grid" data-reveal>
        <div class="flagship-plate">
          {flagship.data.cover && (
            <img src={`/covers/${flagship.data.cover}`} alt={flagship.data.title} class="flagship-img" />
          )}
        </div>
        <div class="flagship-body">
          {flagship.data.category && <span class="flagship-cat">{flagship.data.category}</span>}
          <h3 class="flagship-name">{flagship.data.title}</h3>
          <p class="flagship-summary">{flagship.data.summary}</p>
          {flagship.data.stack && flagship.data.stack.length > 0 && (
            <div class="flagship-stack">
              {flagship.data.stack.slice(0, 5).join(' · ')}
            </div>
          )}
          <div class="flagship-actions">
            <a href={`/projects/${flagship.slug}/`} class="btn btn-primary">
              View project
              <span class="arrow"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 19L19 5M19 5H8M19 5v11"/></svg></span>
            </a>
            {flagship.data.website && (
              <a href={flagship.data.website} class="btn btn-ghost" target="_blank" rel="noreferrer noopener">
                Website ↗
              </a>
            )}
          </div>
        </div>
      </div>

      {restProjects.length > 0 && (
        <div class="home-card-strip-outer">
          <button
            class="strip-nav strip-nav--prev"
            type="button"
            aria-label="Scroll to previous projects"
            data-strip-prev
            hidden
          >
            <span class="strip-nav__glyph" aria-hidden="true">‹</span>
          </button>
          <div class="home-card-strip" role="list" data-strip>
            {restProjects.map((project, i) => {
              const href = `/projects/${project.slug}/`
              const links = [
                project.data.repo    ? { label: 'GitHub', href: project.data.repo }    : null,
                project.data.website ? { label: 'Site',   href: project.data.website } : null,
                project.data.link?.href
                  ? { label: project.data.link.label ?? 'Link', href: project.data.link.href }
                  : null,
              ].filter((l): l is { label: string; href: string } => l !== null)
              const image = project.data.cover
                ? `/covers/${project.data.cover}`
                : project.data.svg ? `/projects/${project.data.svg}` : undefined
              return (
                <ProjectCard
                  client:visible
                  idx={pad(i + 1)}
                  category={project.data.category}
                  name={project.data.title}
                  blurb={project.data.summary}
                  status={project.data.status}
                  href={href}
                  links={links}
                  image={image}
                  year={new Date().getFullYear()}
                />
              )
            })}
          </div>
          <button
            class="strip-nav strip-nav--next"
            type="button"
            aria-label="Scroll to next projects"
            data-strip-next
            hidden
          >
            <span class="strip-nav__glyph" aria-hidden="true">›</span>
          </button>
        </div>
      )}

      <div class="work-foot">
        <a href="/projects/" class="see-all">All projects →</a>
      </div>
    </div>
  </section>

  <!-- ─────── WRITING §III ─────── -->
  <section class="home-section" id="writing">
    <div class="home-container">
      <EdSectionHeader
        numeral="III"
        title="Long-form, mostly about how <em>models think</em>."
        eyebrow="Writing — Nº 03"
        coord={`${pad(recentPosts.length)} essays · indexed`}
      />

      {recentPosts.length > 0 ? (
        <div class="writing-grid">
          {recentPosts.map(post => {
            const month = post.data.dateRaw.toLocaleString('en', { month: 'short', timeZone: 'UTC' }).toUpperCase()
            return (
              <WriteItem
                client:visible
                year={post.data.dateRaw.getUTCFullYear()}
                month={month}
                name={post.data.title}
                desc={post.data.description}
                tags={post.data.tag ? [post.data.tag] : []}
                href={`/posts/${post.slug}/`}
              />
            )
          })}
        </div>
      ) : (
        <p class="empty">No essays indexed yet. Notebook is open.</p>
      )}

      <div class="work-foot">
        <a href="/blog/" class="see-all">All writing →</a>
      </div>
    </div>
  </section>

  <!-- ─────── READING §IV ─────── -->
  <section class="home-section reading-section" id="reading">
    <div class="home-container">
      <EdSectionHeader
        numeral="IV"
        title="What I'm <em>reading</em> and recommend."
        eyebrow="Reading — Nº 04"
        coord={`${allBooks.length} books · ${allWhitepapers.length} papers`}
      />

      <div class="reading-strip">
        {readingHighlights.map(item => (
          <div class="reading-col" data-reveal>
            <div class="k">{item.kind}</div>
            <div class="v">{item.title}</div>
            <div class="sub">{item.meta}</div>
          </div>
        ))}
      </div>

      <div class="work-foot">
        <a href="/reading/" class="see-all">All reading →</a>
      </div>
    </div>
  </section>

  <!-- ─────── CONTACT §V ─────── -->
  <section class="home-cta" id="contact">
    <div class="home-container">
      <EdSectionHeader
        numeral="V"
        title="Drop me a <em>line</em>"
        eyebrow="Get in touch — Nº 05"
        coord="Say hi"
      />
      <div class="cta-actions" data-reveal>
        <a class="email-pill" href={`mailto:${siteConfig.email}`}>
          <span>{siteConfig.email}</span>
          <span class="arrow-circle"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 19L19 5M19 5H8M19 5v11"/></svg></span>
        </a>
        <span class="cta-foot">Say hi</span>
      </div>
    </div>
  </section>
</EditorialLayout>

<style is:global>
  /* Homepage-specific layout. Components keep their own scoped styles;
     this stylesheet covers the editorial sections and bare HTML scaffolding. */

  .home-container {
    max-width: 1360px;
    margin: 0 auto;
    padding: 0 64px;
    position: relative;
  }
  @media (max-width: 820px) {
    .home-container { padding: 0 22px; }
  }

  /* ---------- HERO ---------- */
  .home-hero { padding: 56px 0 36px; position: relative; }
  .hero-grid {
    display: grid;
    grid-template-columns: 1.15fr 0.85fr;
    gap: 64px;
    align-items: start;
  }
  .hero-copy { padding-top: 4px; }

  .label {
    font-family: var(--caps);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: var(--ink-mute);
    display: inline-flex;
    align-items: baseline;
    gap: 10px;
  }
  .label .ix {
    color: var(--ink-faint);
    font-family: var(--mono);
    letter-spacing: 0.12em;
    font-size: 10.5px;
  }

  .display {
    font-family: var(--serif);
    font-weight: 500;
    font-size: var(--fs-display);
    line-height: 0.96;
    letter-spacing: -0.02em;
    margin: 22px 0 28px;
    color: var(--ink);
    text-wrap: balance;
  }
  .display em { font-style: italic; font-weight: 500; color: var(--coral); }
  .display .dot { color: var(--coral); }

  .lead {
    font-family: var(--body);
    font-size: 19px;
    line-height: 1.55;
    color: var(--ink-soft);
    max-width: 560px;
    margin-bottom: 32px;
    text-wrap: pretty;
  }
  .lead em { font-style: italic; color: var(--coral); }

  .hero-actions {
    display: inline-flex;
    flex-wrap: wrap;
    gap: 14px;
    margin-bottom: 34px;
  }
  .btn .arrow { width: 16px; height: 16px; display: inline-grid; place-items: center; }
  .btn .arrow svg { width: 16px; height: 16px; stroke: currentColor; fill: none; stroke-width: 1.6; }

  .hero-stats {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 24px;
    padding: 20px 0;
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
  }
  .stat { display: flex; align-items: center; gap: 14px; }
  .stat .ring {
    width: 56px; height: 56px;
    border-radius: 50%;
    display: inline-grid;
    place-items: center;
    border: 1px solid var(--ink);
    background: transparent;
    font-family: var(--serif);
    font-size: 22px;
    font-weight: 600;
    color: var(--ink);
    flex-shrink: 0;
  }
  .stat .ring.solid { background: var(--ink); color: var(--paper); }
  .stat .ring.coral {
    background: var(--coral);
    border-color: var(--coral);
    color: var(--bone);
  }
  .stat-label {
    display: flex;
    flex-direction: column;
    gap: 2px;
    font-family: var(--caps);
    font-size: 12px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink-faint);
  }
  .stat-label b { color: var(--ink); font-weight: 600; }

  .hero-foot {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 24px;
    margin-top: 14px;
  }
  .hero-foot .meta {
    font-family: var(--mono);
    font-size: 11.5px;
    color: var(--ink-mute);
    letter-spacing: 0.02em;
  }

  /* hero art / portrait plate */
  .hero-art {
    position: relative;
    aspect-ratio: 4 / 5;
    background: var(--bone);
    border: 1px solid var(--ink);
    overflow: hidden;
    isolation: isolate;
  }
  .hero-portrait {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: grayscale(1) contrast(1.05);
    mix-blend-mode: multiply;
  }
  html.dark .hero-portrait {
    filter: grayscale(1) contrast(0.95) brightness(0.92);
    mix-blend-mode: screen;
  }
  .hero-art::after {
    content: '';
    position: absolute; inset: 0;
    pointer-events: none;
    background: repeating-linear-gradient(180deg, transparent 0 3px, rgba(21,20,15,0.04) 3px 4px);
  }
  .corner {
    position: absolute;
    width: 18px; height: 18px;
    border: 1px solid var(--ink);
    z-index: 2;
    background: var(--bone);
  }
  .corner.tl { top: -1px; left: -1px; border-right: none; border-bottom: none; }
  .corner.tr { top: -1px; right: -1px; border-left: none; border-bottom: none; }
  .corner.bl { bottom: -1px; left: -1px; border-right: none; border-top: none; }
  .corner.br { bottom: -1px; right: -1px; border-left: none; border-top: none; }
  .annot {
    position: absolute;
    z-index: 2;
    padding: 4px 8px;
    background: var(--bone);
    border: 1px solid var(--ink);
    font-family: var(--sans);
    font-size: 9.5px;
    font-weight: 600;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--ink);
  }
  .annot-tl { top: 14px; left: 14px; }
  .annot-tr { top: 14px; right: 14px; }
  .annot-bl { bottom: 14px; left: 14px; }
  .annot-br { bottom: 14px; right: 14px; }

  .art-index {
    position: absolute;
    left: 14px; right: 14px; bottom: 0;
    z-index: 2;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 6px;
    font-family: var(--mono);
    font-size: 10.5px;
    letter-spacing: 0.06em;
    color: var(--ink);
    text-transform: uppercase;
  }
  .art-index span {
    background: var(--bone);
    border: 1px solid var(--ink);
    padding: 6px 8px;
    display: flex;
    flex-direction: column;
    gap: 2px;
    opacity: 0.8;
  }
  .art-index .on {
    background: var(--coral);
    border-color: var(--coral);
    color: var(--bone);
    opacity: 1;
  }
  .art-index .n { font-size: 9px; color: var(--ink-faint); }
  .art-index .on .n { color: rgba(247, 241, 222, 0.7); }

  @media (max-width: 980px) {
    .home-hero { padding: 48px 0 40px; }
    .hero-grid { grid-template-columns: 1fr; gap: 40px; }
    .hero-stats { grid-template-columns: 1fr; gap: 16px; padding: 22px 0; }
  }

  /* ---------- SECTION shell ---------- */
  .home-section {
    padding: 72px 0;
    border-top: 1px solid var(--line);
    position: relative;
  }
  .home-section.reading-section { padding-bottom: 56px; }
  .home-section#about { padding: 60px 0; }
  @media (max-width: 820px) {
    .home-section { padding: 64px 0; }
    .home-section#about { padding: 56px 0; }
  }

  /* ---------- ABOUT ---------- */
  .about-grid {
    display: grid;
    grid-template-columns: 1.05fr 0.95fr;
    gap: 64px;
    align-items: start;
  }
  .about-prose {
    font-family: var(--serif);
    font-size: 20px;
    line-height: 1.5;
    color: var(--ink);
    max-width: 640px;
    text-wrap: pretty;
  }
  .about-prose p + p { margin-top: 18px; }
  .about-prose em { color: var(--coral); font-style: italic; }
  .about-prose a {
    color: var(--ink);
    text-decoration: none;
    border-bottom: 1px solid var(--coral);
  }
  .about-prose a:hover { color: var(--coral); }

  .dispatch {
    border: 1px solid var(--ink);
    background: var(--bone);
    padding: 0;
  }
  .dispatch-row {
    display: grid;
    grid-template-columns: 132px 1fr;
    padding: 18px 22px;
    border-bottom: 1px solid var(--line);
    gap: 18px;
    align-items: baseline;
  }
  .dispatch-row:last-child { border-bottom: none; }
  .dispatch-row .k {
    font-family: var(--caps);
    font-size: 10.5px;
    font-weight: 600;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: var(--ink-faint);
  }
  .dispatch-row .v {
    font-family: var(--body);
    font-size: 15.5px;
    color: var(--ink);
    line-height: 1.4;
  }
  .dispatch-row .v b { font-weight: 600; }
  .dispatch-row .v .tag {
    font-family: var(--mono);
    font-size: 11.5px;
    color: var(--ink-mute);
    margin-left: 6px;
  }
  .dispatch-row .v.status-row {
    display: inline-flex;
    align-items: center;
    gap: 10px;
  }
  .status-dot {
    width: 7px; height: 7px;
    border-radius: 50%;
    background: var(--olive);
    display: inline-block;
    box-shadow: 0 0 0 3px rgba(110, 116, 72, 0.18);
  }

  @media (max-width: 980px) {
    .about-grid { grid-template-columns: 1fr; gap: 40px; }
    .dispatch-row { grid-template-columns: 100px 1fr; padding: 14px 18px; }
  }

  /* ---------- WORK + WRITING grid shells ---------- */
  .work-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0;
    border-top: 1px solid var(--ink);
  }
  .writing-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0;
    border-top: 1px solid var(--ink);
  }
  @media (max-width: 820px) {
    .writing-grid { grid-template-columns: 1fr; }
  }
  .work-foot {
    margin-top: 20px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
    flex-wrap: wrap;
    font-family: var(--mono);
