---
import EditorialLayout from '@/layouts/EditorialLayout.astro'
import EdSectionHeader from '@/components/EdSectionHeader.astro'
import ProjectCard from '@/components/ProjectCard.vue'
import { getProjects, partitionFlagship } from '@/utils/projects'

const all = await getProjects()
const { flagship, rest } = partitionFlagship(all)

const pad = (n: number) => String(n).padStart(2, '0')
const year = new Date().getFullYear()

const activeCount = all.filter(p => p.data.status === 'active').length
const archiveCount = all.length - activeCount

// Group by category, preserving sort order within each group
const categoryMap = new Map<string, Array<{ project: (typeof rest)[0]; globalIdx: number }>>()
rest.forEach((project, i) => {
  const cat = project.data.category ?? 'Other'
  if (!categoryMap.has(cat)) categoryMap.set(cat, [])
  categoryMap.get(cat)!.push({ project, globalIdx: i + 1 })
})
const categories = [...categoryMap.entries()]

const flHref = flagship?.data.website ?? flagship?.data.repo ?? (flagship ? `/projects/${flagship.slug}/` : '#')
const flSvg = flagship?.data.cover
  ? `/covers/${flagship.data.cover}`
  : flagship?.data.svg ? `/projects/${flagship.data.svg}` : undefined
---

<EditorialLayout
  title="Projects · Brennon Williams"
  description="Selected work — agents, dev tooling, voice systems, infrastructure, hardware, game AI."
  mainWidth="wider"
>
  <EdSectionHeader
    numeral="II"
    title="<em>Adventures</em> in code and language, curated."
    eyebrow="Projects — Nº 02"
    coord={`${all.length} entries · ${activeCount} active · ${archiveCount} archive`}
    level={1}
  />

  {flagship && (
    <>
      <div class="flagship-lead" data-reveal>
        <div class="fl-body">
          <div class="fl-eyebrow">
            <span class="fl-badge">Flagship</span>
            {flagship.data.status === 'active' && <span class="fl-status-dot" aria-label="Active" />}
            {flagship.data.category && <span class="fl-cat">{flagship.data.category}</span>}
          </div>
          <h2 class="fl-title" set:html={flagship.data.title} />
          <p class="fl-summary">{flagship.data.summary}</p>
          {flagship.data.stack && (
            <div class="fl-stats">
              {flagship.data.stack.map(s => <span class="fl-stat">{s}</span>)}
            </div>
          )}
          <div class="fl-actions">
            <a href={flHref} target="_blank" rel="noreferrer noopener" class="fl-link">
              {flagship.data.website ? flagship.data.website.replace('https://', '') : 'View on GitHub'} →
            </a>
            <a href={`/projects/${flagship.slug}/`} class="fl-detail">Detail page</a>
          </div>
        </div>
        <div class="fl-art">
          <div class="fl-corner fl-corner--tl">
            <span class="fl-corner-sym">№</span>
            <span class="fl-corner-num">00</span>
          </div>
          <div class="fl-corner fl-corner--br" aria-hidden="true">
            <span class="fl-corner-sym">№</span>
            <span class="fl-corner-num">00</span>
          </div>
          <div class="fl-art-image-wrap">
            {flSvg
              ? <img src={flSvg} alt={flagship.data.title} class="fl-img" />
              : <span class="fl-initial" aria-hidden="true">{flagship.data.title.replace(/<[^>]*>/g, '').charAt(0).toUpperCase()}</span>
            }
          </div>
        </div>
      </div>

      <div class="more-header">
        <span class="more-label">More Projects</span>
        <span class="more-count">{rest.length}</span>
      </div>
    </>
  )}

  {categories.map(([cat, items]) => (
    <div class="category-section">
      <div class="category-header">
        <span class="category-name">{cat}</span>
        <span class="category-count">{items.length}</span>
      </div>
      <div class="card-strip-outer">
        <div class="card-strip" role="list">
          {items.map(({ project, globalIdx }) => {
            const href = `/projects/${project.slug}/`
            const links = [
              project.data.repo    ? { label: 'GitHub', href: project.data.repo }    : null,
              project.data.website ? { label: 'Site',   href: project.data.website } : null,
              project.data.link?.href
                ? { label: project.data.link.label ?? 'Link', href: project.data.link.href }
                : null,
            ].filter((l): l is { label: string; href: string } => l !== null)
            const image = project.data.cover
              ? `/covers/${project.data.cover}`
              : project.data.svg ? `/projects/${project.data.svg}` : undefined
            return (
              <ProjectCard
                client:visible
                idx={pad(globalIdx)}
                category={project.data.category}
                name={project.data.title}
                blurb={project.data.summary}
                status={project.data.status}
                href={href}
                links={links}
                image={image}
                year={year}
              />
            )
          })}
        </div>
      </div>
    </div>
  ))}
</EditorialLayout>

<style>
  /* ── Flagship lead ─────────────────────────────── */
  .flagship-lead {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 56px;
    align-items: start;
    max-width: 840px;
    margin-inline: auto;
    padding: 40px 0 48px;
    border-bottom: 1px solid var(--line);
    margin-bottom: 40px;
  }

  .fl-art {
    width: clamp(200px, 26vw, 300px);
    margin-top: 4px;
  }

  .fl-eyebrow {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 20px;
  }

  .fl-status-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--coral);
    flex-shrink: 0;
  }

  .fl-badge {
    font-family: var(--caps);
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--paper);
    background: var(--coral);
    padding: 3px 8px;
    border-radius: 2px;
  }

  .fl-cat {
    font-family: var(--caps);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--ink-mute);
  }

  .fl-title {
    font-family: var(--serif);
    font-size: clamp(30px, 3.4vw, 48px);
    font-weight: 500;
    line-height: 1.05;
    letter-spacing: -0.02em;
    color: var(--ink);
    margin: 0 0 18px;
  }

  .fl-title :global(em) {
    font-style: italic;
    color: var(--coral);
  }

  .fl-summary {
    font-family: var(--body);
    font-size: 15px;
    line-height: 1.65;
    color: var(--ink-soft);
    margin: 0 0 22px;
    max-width: 48ch;
  }

  .fl-stats {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-bottom: 28px;
  }

  .fl-stat {
    font-family: var(--mono);
    font-size: 11px;
    color: var(--ink-mute);
    border: 1px solid var(--line-soft);
    padding: 4px 10px;
    border-radius: 2px;
    letter-spacing: 0.04em;
  }

  .fl-actions {
    display: flex;
    align-items: center;
    gap: 20px;
  }

  .fl-link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-family: var(--caps);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--paper);
    background: var(--ink);
    padding: 11px 18px;
    border-radius: 3px;
    text-decoration: none;
    border: 1px solid var(--ink);
    transition: background var(--dur-base) var(--ease-standard),
                border-color var(--dur-base) var(--ease-standard),
                color var(--dur-base) var(--ease-standard);
  }

  @media (hover: hover) and (pointer: fine) {
    .fl-link:hover {
      background: var(--coral);
      border-color: var(--coral);
      color: white;
    }
  }

  .fl-detail {
    font-family: var(--caps);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--ink-mute);
    text-decoration: none;
    border-bottom: 1px solid var(--line);
    transition: color var(--dur-base), border-color var(--dur-base);
  }

  @media (hover: hover) and (pointer: fine) {
    .fl-detail:hover {
      color: var(--ink);
      border-color: var(--ink);
    }
  }

  .fl-art {
    aspect-ratio: 5 / 7;
    position: relative;
    background: var(--bone);
    border: 1px solid var(--line-soft);
    border-radius: 10px;
    overflow: hidden;
    box-shadow:
      inset 0 0 0 8px var(--paper),
      inset 0 0 0 9px var(--line-soft),
      0 2px 6px rgba(0,0,0,0.08),
      0 8px 24px rgba(0,0,0,0.06),
      0 1px 2px rgba(0,0,0,0.10);
  }

  /* Paper grain overlay — mirrors .project-card::after */
  .fl-art::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    background-image: url("data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' width='200' height='200'><filter id='n'><feTurbulence type='fractalNoise' baseFrequency='0.75' numOctaves='4' stitchTiles='stitch'/></filter><rect width='200' height='200' filter='url(%23n)' opacity='1'/></svg>");
    opacity: 0.05;
    mix-blend-mode: overlay;
    pointer-events: none;
    z-index: 4;
  }

  .fl-corner {
    position: absolute;
    z-index: 3;
    display: flex;
    flex-direction: column;
    align-items: center;
    line-height: 1;
    gap: 1px;
    pointer-events: none;
    user-select: none;
  }

  .fl-corner--tl { top: 5px; left: 7px; }
  .fl-corner--br { bottom: 5px; right: 7px; transform: rotate(180deg); }

  .fl-corner-sym {
    font-family: var(--mono);
    font-size: 7px;
    color: var(--ink-mute);
    letter-spacing: 0.05em;
    line-height: 1;
  }

  .fl-corner-num {
    font-family: var(--mono);
    font-size: 12px;
    font-weight: 500;
    color: var(--ink-soft);
    line-height: 1;
    letter-spacing: -0.02em;
  }

  .fl-art-image-wrap {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 0;
  }

  .fl-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .fl-initial {
    font-family: var(--serif);
    font-style: italic;
    font-size: 120px;
    font-weight: 500;
    color: var(--line);
    line-height: 1;
    user-select: none;
  }

  /* ── "More Projects" divider ───────────────────── */
  .more-header {
    display: flex;
    align-items: baseline;
    gap: 8px;
    margin-bottom: 16px;
    padding-left: 2px;
  }

  .more-label {
    font-family: var(--caps);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--ink-mute);
  }

  .more-count {
    font-family: var(--mono);
    font-size: 10px;
    color: var(--ink-faint);
  }

  /* ── Responsive ────────────────────────────────── */
  @media (max-width: 820px) {
    .flagship-lead {
      grid-template-columns: 1fr;
      gap: 32px;
    }

    .fl-art {
      max-width: 200px;
      margin-top: 0;
    }
  }

  /* ── Category strips ───────────────────────────── */
  .category-section {
    margin-bottom: 40px;
  }

  .category-header {
    display: flex;
    align-items: baseline;
    gap: 8px;
    margin-bottom: 12px;
    padding-left: 2px;
  }

  .category-name {
    font-family: var(--caps);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--ink-mute);
  }

  .category-count {
    font-family: var(--mono);
    font-size: 10px;
    color: var(--ink-faint);
  }

  .card-strip-outer {
    position: relative;
    -webkit-mask-image: linear-gradient(to right, black 80%, transparent 100%);
    mask-image: linear-gradient(to right, black 80%, transparent 100%);
  }
  .card-strip {
    display: flex;
    flex-direction: row;
    gap: 24px;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    -webkit-overflow-scrolling: touch;
    padding: 16px 2px 24px;
    scrollbar-width: none;
  }
  .card-strip::-webkit-scrollbar {
    display: none;
  }
</style>
