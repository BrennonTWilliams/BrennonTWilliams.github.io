---
import EditorialLayout from '@/layouts/EditorialLayout.astro'
import EdSectionHeader from '@/components/EdSectionHeader.astro'
import WorkCard from '@/components/WorkCard.vue'
import { getProjects } from '@/utils/projects'

const all = await getProjects()
const pad = (n: number) => String(n).padStart(2, '0')

// Find the index of the first archive entry so we can splice in a divider row.
// Suppress the divider when the list is all-one-status.
const firstArchiveIdx = all.findIndex(p => p.data.status === 'archive')
const hasActive = all.some(p => p.data.status === 'active')
const showDivider = firstArchiveIdx > 0 && hasActive
const activeCount = all.filter(p => p.data.status === 'active').length
const archiveCount = all.length - activeCount
---

<EditorialLayout
  title="Projects · Brennon Williams"
  description="Selected work — agents, dev tooling, voice systems, infrastructure, hardware, game AI."
  mainWidth="wider"
>
  <EdSectionHeader
    numeral="II"
    title="<em>Work</em>, indexed."
    eyebrow="Projects — Nº 02"
    coord={`${all.length} entries · ${activeCount} active · ${archiveCount} archive`}
    level={1}
  />

  <div class="work-grid">
    {all.map((project, i) => {
      const href = project.data.link?.href ?? project.data.website ?? project.data.repo ?? `/projects/${project.slug}/`
      const external = Boolean(project.data.link?.href ?? project.data.website ?? project.data.repo)
      return (
        <>
          {showDivider && i === firstArchiveIdx && (
            <div class="archive-divider" aria-hidden="true">
              <span class="roman">Archive</span>
              <span class="coord">— {archiveCount} entries</span>
            </div>
          )}
          <WorkCard
            client:visible
            idx={pad(i + 1)}
            category={project.data.category}
            name={project.data.title}
            stack={project.data.stack}
            blurb={project.data.summary}
            status={project.data.status}
            href={href}
            external={external}
          />
        </>
      )
    })}
  </div>
</EditorialLayout>

<style>
  .work-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0;
    border-top: 1px solid var(--ink);
  }
  .archive-divider {
    display: flex;
    align-items: baseline;
    gap: 14px;
    padding: 36px 0 12px;
    border-bottom: 1px solid var(--line);
    margin-bottom: 4px;
  }
  .archive-divider .roman {
    font-family: var(--serif);
    font-style: italic;
    font-weight: 500;
    font-size: 22px;
    color: var(--ink-mute);
  }
  .archive-divider .coord {
    color: var(--ink-faint);
  }
</style>
