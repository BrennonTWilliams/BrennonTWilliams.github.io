---
import { getCollection } from 'astro:content'
import EditorialLayout from '@/layouts/EditorialLayout.astro'
import ArticleNav from '@/components/ArticleNav.astro'
import { sortProjects } from '@/utils/projects'
import type { CollectionProjects } from '@/types'

export async function getStaticPaths() {
  const ordered = sortProjects(
    (await getCollection('projects')).filter(p => !p.data.draft),
  )
  return ordered.map((project, i) => ({
    params: { slug: project.slug },
    props: {
      project,
      prev: i > 0 ? ordered[i - 1] : null,
      next: i < ordered.length - 1 ? ordered[i + 1] : null,
    },
  }))
}

type Props = {
  project: CollectionProjects
  prev: CollectionProjects | null
  next: CollectionProjects | null
}

const { project, prev, next } = Astro.props
const { title, category, status, repo, website, summary, stack, link } = project.data
const { Content } = await project.render()

const primaryLink = link ?? (website ? { href: website, label: 'Visit website' } : null)
const repoLink = repo && repo !== 'TBD' && repo !== 'private' ? repo : null

const toCell = (p: CollectionProjects | null) =>
  p
    ? { href: `/projects/${p.slug}/`, title: p.data.title, eyebrow: p.data.category ?? 'Project' }
    : null
---

<EditorialLayout
  title={`${title} · Projects`}
  description={summary}
  pageType="article"
  mainWidth="wide"
>
  <article class="article">
    <header class="article-header">
      <span class="roman">§</span>
      {category && <span class="eyebrow article-tag">{category}</span>}
      <h1 class="article-title" set:html={title} />
      {summary && <p class="article-description">{summary}</p>}

      <div class="article-meta">
        <span class={`status-pill status-${status}`}>{status === 'active' ? 'Active' : 'Archive'}</span>
        {stack && stack.length > 0 && (
          <>
            <span class="meta-separator" aria-hidden="true">·</span>
            <span class="meta-stack">{stack.join(' · ')}</span>
          </>
        )}
      </div>

      {(primaryLink || repoLink) && (
        <div class="article-actions">
          {primaryLink && (
            <a class="btn btn-primary" href={primaryLink.href} target="_blank" rel="noreferrer noopener">
              {primaryLink.label ?? primaryLink.href.replace(/^https?:\/\//, '').replace(/\/$/, '')}
              <span class="arrow"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7 17L17 7M17 7H8M17 7v9"/></svg></span>
            </a>
          )}
          {repoLink && (
            <a class="btn btn-ghost" href={repoLink} target="_blank" rel="noreferrer noopener">
              Source
              <span class="arrow"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7 17L17 7M17 7H8M17 7v9"/></svg></span>
            </a>
          )}
        </div>
      )}
    </header>

    <div class="prose article-body">
      <Content />
    </div>

    <ArticleNav prev={toCell(prev)} next={toCell(next)} />
  </article>
</EditorialLayout>

<style>
  .article-header {
    margin-bottom: 48px;
    padding-bottom: 28px;
    border-bottom: 1px solid var(--line);
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .article-header .roman {
    font-family: var(--serif);
    font-style: italic;
    font-weight: 500;
    font-size: 22px;
    color: var(--ink-faint);
  }
  .article-tag {
    color: var(--coral);
  }
  .article-title {
    font-family: var(--serif);
    font-weight: 500;
    font-size: var(--fs-h1);
    line-height: 1.05;
    letter-spacing: -0.015em;
    color: var(--ink);
    margin: 4px 0 0 0;
    text-wrap: balance;
  }
  .article-title :global(em) { color: var(--coral); font-style: italic; }

  .article-description {
    font-family: var(--serif);
    font-style: italic;
    font-size: 20px;
    line-height: 1.45;
    color: var(--ink-soft);
    max-width: 640px;
    text-wrap: pretty;
    margin: 0;
  }

  .article-meta {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 10px;
    font-family: var(--mono);
    font-size: 11.5px;
    color: var(--ink-mute);
    letter-spacing: 0.04em;
    margin-top: 8px;
  }
  .status-pill {
    font-family: var(--sans);
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--ink-mute);
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 4px 10px;
    border: 1px solid var(--line);
    border-radius: 999px;
  }
  .status-pill::before {
    content: '';
    width: 6px; height: 6px;
    border-radius: 50%;
    background: var(--ink-faint);
  }
  .status-pill.status-active {
    color: var(--olive);
    border-color: var(--olive);
  }
  .status-pill.status-active::before {
    background: var(--olive);
    box-shadow: 0 0 0 3px rgba(110, 116, 72, 0.18);
  }
  .meta-separator { color: var(--ink-faint); }
  .meta-stack {
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  .article-actions {
    display: inline-flex;
    flex-wrap: wrap;
    gap: 14px;
    margin-top: 12px;
  }
  .article-actions .arrow { width: 14px; height: 14px; display: inline-grid; place-items: center; }
  .article-actions .arrow svg { width: 14px; height: 14px; stroke: currentColor; fill: none; stroke-width: 1.6; }

  .article-body {
    margin-top: 8px;
  }
</style>
