---
import EditorialLayout from '@/layouts/EditorialLayout.astro'
import EdSectionHeader from '@/components/EdSectionHeader.astro'
import siteConfig from '@/site-config'

const updated = new Date(`${siteConfig.now.lastUpdated}T00:00:00Z`)
const updatedLabel = updated.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
  timeZone: 'UTC',
})
---

<EditorialLayout
  title={`Now · ${siteConfig.author}`}
  description="What I'm building, reading, listening to, and doing off-screen."
  mainWidth="wide"
>
  <EdSectionHeader
    numeral="I"
    title="What I'm <em>doing</em> right now."
    eyebrow="Now — Nº 04"
    coord={`Updated ${siteConfig.now.lastUpdated}`}
    level={1}
  />

  <div class="now-strip">
    {siteConfig.now.entries.map(entry => (
      <div class="now-col" data-reveal>
        <div class="k">{entry.kind}</div>
        <div class="v" set:html={entry.title} />
        <div class="sub">{entry.meta}</div>
      </div>
    ))}
  </div>

  <p class="coord now-foot">Last updated {updatedLabel}</p>
</EditorialLayout>

<style>
  .now-strip {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
  }
  .now-col {
    padding: 22px 24px;
    border-right: 1px solid var(--line);
  }
  .now-col:last-child { border-right: none; }
  .now-col .k {
    font-family: var(--sans);
    font-size: 10.5px;
    font-weight: 600;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: var(--ink-faint);
    margin-bottom: 14px;
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }
  .now-col .k::before {
    content: '';
    width: 6px; height: 6px;
    border-radius: 50%;
    background: var(--coral);
  }
  .now-col .v {
    font-family: var(--serif);
    font-size: 19px;
    font-weight: 500;
    line-height: 1.25;
    color: var(--ink);
    text-wrap: balance;
  }
  .now-col .v :global(em) { font-style: italic; color: var(--coral); }
  .now-col .sub {
    font-family: var(--mono);
    font-size: 11px;
    color: var(--ink-mute);
    margin-top: 8px;
    letter-spacing: 0.03em;
  }
  .now-foot {
    margin-top: 32px;
    text-align: right;
  }
  @media (max-width: 820px) {
    .now-strip { grid-template-columns: 1fr 1fr; }
    .now-col:nth-child(2n) { border-right: none; }
  }
  @media (max-width: 480px) {
    .now-strip { grid-template-columns: 1fr; }
    .now-col {
      border-right: none;
      border-bottom: 1px solid var(--line);
    }
    .now-col:last-child { border-bottom: none; }
  }
</style>
