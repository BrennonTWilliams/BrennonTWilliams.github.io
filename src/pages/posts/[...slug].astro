---
import EditorialLayout from '@/layouts/EditorialLayout.astro'
import ArticleNav from '@/components/ArticleNav.astro'
import { type CollectionPosts } from '@/types'
import { getPosts } from '@/utils/posts'
import { siteConfig } from '@/site-config'

export async function getStaticPaths() {
  const posts = await getPosts()
  return posts.map((post, i) => ({
    params: { slug: post.slug },
    props: {
      post,
      prev: i < posts.length - 1 ? posts[i + 1] : null, // newest-first sort: "prev" = older
      next: i > 0 ? posts[i - 1] : null,                 // "next" = newer
    },
  }))
}

type Props = {
  post: CollectionPosts
  prev: CollectionPosts | null
  next: CollectionPosts | null
}

const { post, prev, next } = Astro.props
const { title, image, description, date, dateRaw, duration, tag, lang } = post.data

const { Content } = await post.render()

const toCell = (p: CollectionPosts | null, label: 'Older' | 'Newer') =>
  p ? { href: `/posts/${p.slug}/`, title: p.data.title, eyebrow: label } : null

const monthFor = (d: Date) => d.toLocaleString('en', { month: 'short', timeZone: 'UTC' }).toUpperCase()

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: title,
  description: description ?? '',
  author: { '@type': 'Person', name: siteConfig.author },
  datePublished: dateRaw.toISOString(),
  dateModified: dateRaw.toISOString(),
  inLanguage: lang ?? 'en-US',
  ...(image ? { image: image.src } : {}),
}
---

<EditorialLayout
  title={title}
  description={description}
  pageType="article"
  mainWidth="wide"
  lang={lang ?? 'en-US'}
  socialImage={image ? { src: image.src, alt: image.alt ?? title } : undefined}
  structuredData={structuredData}
>
  <article class="article">
    <header class="article-header">
      <span class="roman">§</span>
      {tag && <span class="eyebrow article-tag">{tag}</span>}
      <h1 class="article-title">{title}</h1>
      {description && <p class="article-description">{description}</p>}

      <div class="article-meta">
        <span class="meta-author">{siteConfig.author}</span>
        <span class="meta-separator" aria-hidden="true">·</span>
        <time datetime={dateRaw.toISOString()} class="meta-date">
          {dateRaw.getUTCFullYear()} · {monthFor(dateRaw)}
        </time>
        <span class="meta-separator" aria-hidden="true">·</span>
        <span class="meta-date">{date}</span>
        {duration && (
          <>
            <span class="meta-separator" aria-hidden="true">·</span>
            <span class="meta-duration">{duration}</span>
          </>
        )}
      </div>
    </header>

    {image && (
      <figure class="article-hero">
        <img
          src={image.src}
          alt={image.alt ?? ''}
          loading="lazy"
          decoding="async"
        />
      </figure>
    )}

    <div class="prose article-body">
      <Content />
    </div>

    <ArticleNav prev={toCell(prev, 'Older')} next={toCell(next, 'Newer')} />
  </article>
</EditorialLayout>

<style>
  .article-header {
    margin-bottom: 48px;
    padding-bottom: 28px;
    border-bottom: 1px solid var(--line);
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .article-header .roman {
    font-family: var(--serif);
    font-style: italic;
    font-weight: 500;
    font-size: 22px;
    color: var(--ink-faint);
  }
  .article-tag {
    color: var(--coral);
  }
  .article-title {
    font-family: var(--serif);
    font-weight: 500;
    font-size: var(--fs-h1);
    line-height: 1.05;
    letter-spacing: -0.015em;
    color: var(--ink);
    margin: 4px 0 0 0;
    text-wrap: balance;
  }
  .article-description {
    font-family: var(--serif);
    font-style: italic;
    font-size: 20px;
    line-height: 1.45;
    color: var(--ink-soft);
    max-width: 640px;
    text-wrap: pretty;
    margin: 0;
  }
  .article-meta {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 10px;
    font-family: var(--mono);
    font-size: 11.5px;
    color: var(--ink-mute);
    letter-spacing: 0.04em;
    margin-top: 8px;
  }
  .meta-author { color: var(--ink); font-weight: 500; }
  .meta-separator { color: var(--ink-faint); }
  .meta-date, .meta-duration {
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  .article-hero {
    margin: 0 0 40px 0;
  }
  .article-hero img {
    width: 100%;
    height: auto;
    display: block;
    border: 1px solid var(--ink);
  }

  .article-body { margin-top: 8px; }
</style>
