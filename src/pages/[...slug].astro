---
import { getCollection } from 'astro:content'
import EditorialLayout from '@/layouts/EditorialLayout.astro'
import type { CollectionPages } from '@/types'

export async function getStaticPaths() {
  const pages = await getCollection('pages')
  return pages.map((page) => ({
    params: { slug: page.slug },
    props: { page },
  }))
}

type Props = { page: CollectionPages }

const { page } = Astro.props
const { title, description, image } = page.data
const { Content } = await page.render()
---

<EditorialLayout title={title} description={description} mainWidth="wide">
  <article class="article">
    <header class="article-header">
      <span class="roman">§</span>
      <h1 class="article-title">{title}</h1>
      {description && <p class="article-description">{description}</p>}
    </header>

    {image && (
      <figure class="article-hero">
        <img
          src={image.src}
          alt={image.alt ?? ''}
          loading="lazy"
          decoding="async"
        />
      </figure>
    )}

    <div class="prose article-body">
      <Content />
    </div>
  </article>
</EditorialLayout>

<style>
  .article-header {
    margin-bottom: 48px;
    padding-bottom: 28px;
    border-bottom: 1px solid var(--line);
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .article-header .roman {
    font-family: var(--serif);
    font-style: italic;
    font-weight: 500;
    font-size: 22px;
    color: var(--ink-faint);
  }
  .article-title {
    font-family: var(--serif);
    font-weight: 500;
    font-size: var(--fs-h1);
    line-height: 1.05;
    letter-spacing: -0.015em;
    color: var(--ink);
    margin: 4px 0 0 0;
    text-wrap: balance;
  }
  .article-description {
    font-family: var(--serif);
    font-style: italic;
    font-size: 20px;
    line-height: 1.45;
    color: var(--ink-soft);
    max-width: 640px;
    margin: 0;
  }
  .article-hero { margin: 0 0 40px 0; }
  .article-hero img {
    width: 100%;
    height: auto;
    display: block;
    border: 1px solid var(--ink);
  }
  .article-body { margin-top: 8px; }
</style>
