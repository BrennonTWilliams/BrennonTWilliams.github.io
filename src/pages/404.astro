---
import EditorialLayout from '@/layouts/EditorialLayout.astro'
---

<EditorialLayout
  title="Not Found — 404"
  description="Page not found. The trail goes cold here."
  mainWidth="wide"
  noindex={true}
>
  <article class="article-404">
    <span class="code">404</span>
    <h1>The trail goes cold here.</h1>
    <p class="lede">No page lives at this URL. It may have moved, or it may have never existed. Either way — let's get you back on the map.</p>

    <div class="actions">
      <a class="btn btn-primary" href="/">
        Home
        <span class="arrow"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 19L19 5M19 5H8M19 5v11"/></svg></span>
      </a>
      <a class="btn btn-ghost" href="/projects/">
        Projects
        <span class="arrow"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 19L19 5M19 5H8M19 5v11"/></svg></span>
      </a>
    </div>
  </article>
</EditorialLayout>

<style>
  .article-404 {
    text-align: center;
    padding: 96px 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 18px;
  }
  .article-404 .code {
    font-family: var(--mono);
    font-size: 14px;
    letter-spacing: 0.3em;
    color: var(--coral);
    text-transform: uppercase;
  }
  .article-404 h1 {
    font-family: var(--serif);
    font-weight: 500;
    font-size: clamp(40px, 6vw, 80px);
    line-height: 1.05;
    letter-spacing: -0.02em;
    color: var(--ink);
    margin: 0;
    text-wrap: balance;
  }
  .article-404 .lede {
    font-family: var(--serif);
    font-style: italic;
    font-size: 20px;
    color: var(--ink-soft);
    max-width: 520px;
    margin: 0;
  }
  .article-404 .actions {
    display: inline-flex;
    flex-wrap: wrap;
    gap: 14px;
    margin-top: 18px;
    justify-content: center;
  }
  .article-404 .arrow { width: 14px; height: 14px; display: inline-grid; place-items: center; }
  .article-404 .arrow svg { width: 14px; height: 14px; stroke: currentColor; fill: none; stroke-width: 1.6; }
</style>
